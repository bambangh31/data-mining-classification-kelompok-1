# File lokal dan hasil pembuatan dokumen
/tmp/
/output/
.DS_Store
Thumbs.db
~$*

# Kredensial lokal
.env
.env.*
!.env.example

# Environment dan cache jika menggunakan Python/Jupyter
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Hanya dua berkas data asli yang dipublikasikan; artefak hasil tetap lokal
/data/raw/*
!/data/raw/README.md
!/data/raw/diabetic_data.csv
!/data/raw/IDS_mapping.csv
/data/processed/*
!/data/processed/README.md
